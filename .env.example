# Database — SQLite for local; PostgreSQL for deployment
DATABASE_URL=sqlite:///./data/pairwise.db
# DATABASE_URL=postgresql+psycopg2://pairwise:pairwise@localhost:5432/pairwise

# LLM provider (openai-compatible). Leave empty for demo-only mode.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

# Dating orchestration
MAX_CONCURRENT_DATES=3
DEFAULT_MAX_TURNS=6
MAX_PROFILE_TEXT_CHARS=20000

# Rate limiting
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_RUNS=5/minute

# Public-profile reading (LinkedIn + Instagram). Works with no keys from a home connection.
SCRAPING_ENABLED=true
# Optional fallbacks for hosted deployments, where datacenter IPs are often blocked:
APIFY_TOKEN=
SCRAPER_PROXY=

# YouTube walkthrough, embedded on the Demo page
DEMO_VIDEO_URL=
